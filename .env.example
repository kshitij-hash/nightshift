# Copy to .env (gitignored) — or better, keep secrets in ~/.nightshift/ outside the tree.
# NEVER commit real values. NEVER paste private keys into chat, issues, or logs.

# Starknet mainnet RPC (Alchemy free tier works)
STARKNET_RPC=https://starknet-mainnet.g.alchemy.com/v2/YOUR_KEY

# Operator account (public half only here; private key stays in ~/.nightshift/)
NIGHTSHIFT_ACCOUNT_ADDRESS=0x0
