# Copy this file to .env and fill it in. .env is never committed; bot.mjs
# reads it at startup and never overrides a variable already set in the real
# environment.

# From @BotFather: /newbot, then the token it gives you. Never paste this
# anywhere but here; whoever has it can send messages as this bot.
BOT_TOKEN=

# A Starknet mainnet RPC endpoint. This is the default public one; swap it
# for your own node or provider if you have one.
STARKNET_RPC=https://rpc.starknet.lava.build

# The NIGHTSHIFT vault this gate checks presentations against.
NIGHTSHIFT_VAULT=0x171e8e0bb905c899b9d1ad5c02aefe96a5d0b6d5f093f0ee80707b592417f8e

# This bot's own stable verifier id. Off-chain, any stable felt will do;
# nightshift-verify encodes a plain word like this one as a Cairo short
# string automatically (see toVerifierFelt in verify/src/index.mjs), so a
# 0x-hex value would also work here unchanged.
VERIFIER_ID=TG_DOOR_1

# The creator_id this gate admits subscribers of. Get it from the NIGHTSHIFT
# ops console (web/): it is printed in the log panel as "creator_id: 0x..."
# right after register_creator, and again as "gate returned creator_id=..."
# after any present. Both of those log lines are fine sources; the check
# compares felts, not strings, so any hex or decimal form of the value works
# here, padded with leading zeros or not.
CREATOR_ID=

# tier -> {chat_id, label}, as JSON on one line. chat_id is the numeric id of
# the private Telegram chat that tier unlocks (see README.md for how to get
# it); label is what the bot names the tier back to the subscriber. The
# tier number itself comes from the vault's schedule_of, set when the
# subscriber called subscribe.
TIER_CHATS={"0":{"chat_id":"-1001234567890","label":"supporter"},"1":{"chat_id":"-1009876543210","label":"insider"}}
